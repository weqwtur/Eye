async def save_disease(data: dict):
    """Вставляє або оновлює хворобу в БД."""
    async with SessionLocal() as session:
        # Перевіряємо чи вже існує
        result = await session.execute(
            select(EyeDisease).where(EyeDisease.name == data["name"])
        )
        existing = result.scalar_one_or_none()

        if existing:
            # Оновлюємо
            for key, val in data.items():
                setattr(existing, key, val)
        else:
            # Створюємо новий
            session.add(EyeDisease(**data))

        await session.commit()


async def main():
    gemini_key = os.getenv("GEMINI_API_KEY")
    if not gemini_key:
        print("❌ GEMINI_API_KEY не знайдено в .env!")
        return

    genai.configure(api_key=gemini_key)
    model = genai.GenerativeModel("gemini-1.5-flash")
    print("✅ Gemini підключено")

    await init_db()

    diseases = get_disease_links()

    success, failed = 0, []

    for i, disease in enumerate(diseases, 1):
        name = disease["name"]
        url  = disease["url"]
        print(f"\n[{i}/{len(diseases)}] {name}")

        try:
            raw_text = scrape_page(url)
            print(f"    📄 {len(raw_text)} символів")
        except Exception as e:
            print(f"    ❌ Парсинг: {e}")
            failed.append(name)
            continue

        try:
            ai = summarize_with_gemini(model, name, raw_text)
            print(f"    🤖 Gemini: OK")
        except Exception as e:
            print(f"    ❌ Gemini: {e}")
            ai = {"summary": "", "symptoms": "", "treatment": "", "risk_factors": ""}

        try:
            await save_disease({
                "name":         name,
                "url":          url,
                "summary":      ai.get("summary", ""),
                "symptoms":     ai.get("symptoms", ""),
                "treatment":    ai.get("treatment", ""),
                "risk_factors": ai.get("risk_factors", ""),
            })
            success += 1
            print(f"    💾 Збережено")
        except Exception as e:
            print(f"    ❌ БД: {e}")
            failed.append(name)

        time.sleep(DELAY_SECONDS)

    print(f"\n{'='*50}")
    print(f"✅ Успішно: {success} хвороб")
    print(f"❌ Помилки: {len(failed)}")
    if failed:
        print("Проблемні:", ", ".join(failed))


if __name__ == "__main__":
    asyncio.run(main())
